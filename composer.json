{
  "name": "stormcelltech/contabo-whmcs",
  "description": "Hardened Contabo provisioning module for supported WHMCS releases",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "php-parallel-lint/php-parallel-lint": "^1.4"
  },
  "autoload": {
    "files": [
      "lib/Contracts.php",
      "lib/Http.php",
      "lib/ContaboApi.php",
      "lib/ProvisioningService.php"
    ]
  },
  "scripts": {
    "lint": "parallel-lint --exclude vendor .",
    "test": "phpunit --colors=always",
    "analyse": "phpstan analyse --no-progress",
    "check": ["@lint", "@test", "@analyse"]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
